{
  "name": "suno-portfolio-scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "scrape": "node src/cli.js",
    "scrape:btg": "node src/cli.js --source btg",
    "btg:browser": "node src/manual-browser.js",
    "wallet:plan": "node src/plan-cli.js",
    "daily": "node src/daily.js",
    "daily:full": "node src/daily.js --full",
    "daily:reindex": "node src/daily.js --reindex",
    "daily:conteudo": "node src/daily.js --content-only",
    "daily:status": "node src/daily-status.js",
    "schedule:install": "sh deploy/install-timer.sh",
    "schedule:windows": "sh deploy/install-windows-task.sh",
    "login": "node src/cli.js --login",
    "session:forget": "node src/cli.js --forget-session",
    "doctor": "node src/doctor.js",
    "test": "node --test --test-isolation=none test/unit.test.js test/session.test.js test/btg.test.js test/login.test.js test/cdp.test.js test/crawler.test.js test/scroll.test.js test/suno-kb.test.js",
    "test:browser": "node --test --test-isolation=none test/*browser.test.js",
    "test:all": "node --test --test-isolation=none test/*.test.js",
    "browser:install": "playwright install chromium"
  },
  "dependencies": { "playwright": "1.64.1" }
}
