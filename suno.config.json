{
  "provider": "suno",
  "baseUrl": "https://investidor.suno.com.br",
  "layoutVerified": false,
  "authenticatedSelector": null,
  "sessionTtlHours": 168,
  "sessionLocalStorageKeys": [],
  "portfolioPath": "/portfolio",
  "walletsPath": "/carteiras",
  "scopePaths": ["/portfolio", "/carteiras"],
  "queryKeys": ["page", "pagina", "tab", "carteira", "wallet", "id"],
  "contentSelector": "main, [role=main]",
  "readySelector": null,
  "walletLinkSelector": "a[href]",
  "readOnlyGraphqlPaths": [],
  "views": [],
  "maxPages": 100,
  "maxPaginationPages": 50,
  "maxScrollSteps": 40,
  "settleMs": 1000,
  "navigationTimeoutMs": 45000,
  "nextSelector": null,
  "loadMoreSelector": null,
  "recordMappings": []
}
